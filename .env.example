# ==============================================================================
# Argus Quant — Environment Configuration Template
# Copy this file to .env and populate your personal API keys:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Macroeconomic Data (FRED API)
# ------------------------------------------------------------------------------
# Optional: The pipeline automatically falls back to FRED public CSV graph endpoints
# if this key is omitted. A free key can be obtained at:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ------------------------------------------------------------------------------
# 2. Financial News Archive (Finnhub API)
# ------------------------------------------------------------------------------
# Optional: The system utilizes cached historical headlines if omitted.
# A free tier API key allows 60 calls/minute:
# https://finnhub.io
FINNHUB_API_KEY=

# ------------------------------------------------------------------------------
# 3. Operations Alert Dispatcher (Telegram Bot API)
# ------------------------------------------------------------------------------
# Optional: If omitted, operational alerts are logged to console and SQLite.
# To receive mobile notifications on pipeline errors, rebalance reports, or
# confidence light color changes, create a bot via @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. Broker Execution (Alpaca & Trading 212)
# ------------------------------------------------------------------------------
# Default broker: dry_run (offline simulation), alpaca, or trading212
DEFAULT_BROKER=dry_run

# Alpaca Markets (Paper trading is free: https://app.alpaca.markets/signup)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Trading 212 (Demo or Live: https://www.trading212.com)
# For accounts requiring key+secret pairs, Basic Auth is automatically encoded.
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENV=demo
TRADING212_BASE_URL=https://demo.trading212.com/api/v0

# ------------------------------------------------------------------------------
# 5. Storage & Logging Settings
# ------------------------------------------------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
